# ============================================================
# BulaClara — Backend (FastAPI)
# Copie este arquivo para .env e preencha cada valor conforme o
# seu ambiente. O arquivo .env NÃO deve ser commitado.
# ============================================================

# Endereço e porta em que a API local sobe (usada pelo Electron)
BULACLARA_API_HOST=127.0.0.1
BULACLARA_API_PORT=8000

# --- Fase 2: bancos de dados ---
# PostgreSQL remoto (fonte de verdade, compartilhada entre instalações)
DATABASE_URL_REMOTE=
# SQLite local (cache offline) — caminho relativo à raiz do repo ou absoluto
BULACLARA_DB_LOCAL_PATH=data/bulaclara_local.db

# --- Fase 3: ANVISA / Bulário Eletrônico ---
ANVISA_BASE_URL=https://consultas.anvisa.gov.br/api/v1

# --- Fase 4: IA generativa (LLM) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- CORS (origens do frontend autorizadas, lista JSON) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","null"]